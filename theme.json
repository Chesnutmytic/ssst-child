{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "color": {
            "palette": [
                {
                    "name": "Cream (Kertas)",
                    "slug": "cream",
                    "color": "#F5EFE0"
                },
                {
                    "name": "Paper (Putih Susu)",
                    "slug": "paper",
                    "color": "#FAF7F0"
                },
                {
                    "name": "Steam (Abu Susu)",
                    "slug": "steam",
                    "color": "#F0E8D8"
                },
                {
                    "name": "Espresso (Hitam Tinta)",
                    "slug": "espresso",
                    "color": "#1A0F0A"
                },
                {
                    "name": "Coffee (Cokelat Dalam)",
                    "slug": "coffee",
                    "color": "#3D2B1F"
                },
                {
                    "name": "Roast (Cokelat Medium)",
                    "slug": "roast",
                    "color": "#5C3D2E"
                },
                {
                    "name": "Caramel (Aksen / CTA)",
                    "slug": "caramel",
                    "color": "#C8763A"
                },
                {
                    "name": "Milk (Border Terang)",
                    "slug": "milk",
                    "color": "#E8D5B7"
                },
                {
                    "name": "Latte (Border Sekunder)",
                    "slug": "latte",
                    "color": "#D4B896"
                }
            ],
            "custom": true,
            "customGradient": true
        },
        "typography": {
            "fontFamilies": [
                {
                    "name": "Caveat (Handwritten)",
                    "slug": "handwritten",
                    "fontFamily": "'Caveat', 'Patrick Hand', cursive"
                },
                {
                    "name": "Nunito Sans (Body)",
                    "slug": "body",
                    "fontFamily": "'Nunito Sans', system-ui, sans-serif"
                }
            ],
            "fontSizes": [
                { "name": "XS",   "slug": "xs",   "size": "0.75rem" },
                { "name": "SM",   "slug": "sm",   "size": "0.875rem" },
                { "name": "Base", "slug": "base", "size": "1rem" },
                { "name": "LG",   "slug": "lg",   "size": "1.125rem" },
                { "name": "XL",   "slug": "xl",   "size": "1.25rem" },
                { "name": "2XL",  "slug": "2xl",  "size": "1.5rem" },
                { "name": "3XL",  "slug": "3xl",  "size": "2rem" },
                { "name": "4XL",  "slug": "4xl",  "size": "2.5rem" },
                { "name": "5XL",  "slug": "5xl",  "size": "3.25rem" },
                { "name": "Hero", "slug": "hero", "size": "clamp(3rem, 8vw, 5.5rem)" }
            ],
            "customFontSize": true,
            "dropCap": false
        },
        "spacing": {
            "spacingScale": {
                "operator": "*",
                "increment": 1.5,
                "steps": 8,
                "mediumStep": 1.5,
                "unit": "rem"
            },
            "units": [ "px", "rem", "em", "%" ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "color": {
            "background": "#F5EFE0",
            "text": "#1A0F0A"
        },
        "typography": {
            "fontFamily": "var:preset|font-family|body",
            "fontSize": "var:preset|font-size|base",
            "lineHeight": "1.6"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var:preset|font-family|handwritten",
                    "fontWeight": "700",
                    "lineHeight": "1.2"
                },
                "color": {
                    "text": "#3D2B1F"
                }
            },
            "link": {
                "color": {
                    "text": "#C8763A"
                },
                ":hover": {
                    "color": {
                        "text": "#A85C26"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "#C8763A",
                    "text": "#FAF7F0"
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|handwritten",
                    "fontWeight": "700",
                    "fontSize": "var:preset|font-size|xl"
                },
                "border": {
                    "radius": "4px 8px 4px 8px",
                    "width": "2px",
                    "color": "#1A0F0A"
                },
                ":hover": {
                    "color": {
                        "background": "#A85C26",
                        "text": "#FAF7F0"
                    }
                }
            }
        }
    }
}

